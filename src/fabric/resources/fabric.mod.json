{
  "schemaVersion": 1,
  "id": "lodgen",
  "version": "${version}",
  "name": "LODgen",
  "description": "Generates chunk-based LODs for Distant Horizons FEATURES and Voxy without saving LOD-only chunks.",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.lodgen.fabric.LodgenEntrypoint"
    ]
  },
  "mixins": [
    "lodgen.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabricLoader}",
    "minecraft": "=${minecraft}",
    "java": ">=${java}"
  },
  "suggests": {
    "c2me": "*",
    "distanthorizons": "=${dhVersion}",
    "voxy": "*"
  }
}
