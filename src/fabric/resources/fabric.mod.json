{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${version}",
  "name": "${modName}",
  "icon": "${modIcon}",
  "description": "${modDescription}",
  "authors": [],
  "license": "${modLicense}",
  "contact": {
    "sources": "${modSourceUrl}",
    "issues": "${modIssueTrackerUrl}",
    "homepage": "${modHomepageUrl}"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.ricky12awesome.lodgen.fabric.LodgenEntrypoint"
    ],
    "modmenu": [
      "dev.ricky12awesome.lodgen.fabric.LodgenModMenu"
    ]
  },
  "mixins": [
    "lodgen.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabricLoader}",
    "fabric-api": "*",
    "minecraft": "=${minecraft}",
    "java": ">=${java}"
  },
  "suggests": {
    "c2me": "*",
    "distanthorizons": "=${dhVersion}",
    "voxy": "*",
    "modmenu": "*"
  }
}
